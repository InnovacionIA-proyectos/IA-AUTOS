# Copiar a .env y completar. NUNCA versionar .env ni compartir valores reales (ver docs/configuracion.md).
# El doble guion bajo (__) separa secciones de la configuracion de ASP.NET Core:
#   Jwt__Secret  equivale a  Jwt:Secret  en appsettings.json.

# ----------------------------------------------------------------------------- Base de datos (SQL Server 2019)
# Usuario de aplicacion con minimo privilegio (database/01-crear-usuario-app.sql). No usar sa en produccion.
ConnectionStrings__DefaultConnection=Server=<host>,1433;Database=IAAutos;User Id=<usuario_app>;Password=<password_app>;Encrypt=True;TrustServerCertificate=False
# Solo para docker-compose local: contrasena del SQL Server de desarrollo (cree una robusta).
MSSQL_SA_PASSWORD=<password_sa_local_robusta>

# ----------------------------------------------------------------------------- Autenticacion (JWT HS256)
# Minimo 32 caracteres. Use el SUPABASE_JWT_SECRET vigente para que las sesiones actuales sigan validas,
# o genere uno nuevo (todos los usuarios deberan iniciar sesion de nuevo).
Jwt__Secret=<secreto_jwt_minimo_32_caracteres>
Jwt__ExpiracionDias=30
# Emisor y destinatario del JWT. Si se definen se exigen: los tokens emitidos antes sin emisor dejan de valer.
# Jwt__Issuer=IA-AUTOS
# Jwt__Audience=IA-AUTOS.Clientes

# ----------------------------------------------------------------------------- Ingesta Sofasa (ETL ya desplegado)
# Debe coincidir con INGEST_TOKEN del ETL (en la API anterior se llamaba ETL_INGEST_TOKEN).
Etl__IngestToken=<token_compartido_con_el_etl>

# ----------------------------------------------------------------------------- CORS
# Origenes de la web, separados por comas. Si se deja vacio no se habilita CORS (la app movil no lo necesita).
# Origenes EXACTOS (sin comodin *). Incluya el origen del portal: uno no registrado se bloquea.
Cors__Origins=https://<dominio-de-la-web>

# ----------------------------------------------------------------------------- Almacenamiento de imagenes
# S3 compatible (el MinIO existente). Si Endpoint o Bucket quedan vacios se guarda en disco (Storage__LocalPath).
Storage__S3__Endpoint=
Storage__S3__Bucket=
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__LocalPath=.uploads
# Tamano maximo de una imagen en bytes (por defecto 10 MB).
Storage__MaximoBytes=10485760
# true = las imagenes se leen sin token (como en el sistema anterior). false = exigen autenticacion.
Storage__LecturaPublica=true

# ----------------------------------------------------------------------------- Notificaciones push (Firebase Cloud Messaging)
# Cuenta de servicio de Firebase. Sin estos tres valores el push no se envia (la notificacion queda con su error de envio). Los saltos de linea de la clave van como \n.
Notificaciones__FcmProyectoId=
Notificaciones__FcmClientEmail=
Notificaciones__FcmClavePrivada=

# ----------------------------------------------------------------------------- Procesos periodicos de alertas
# Los avisos (captura incompleta y transferencia pendiente) corren cada 10 minutos y los patrones por umbral cada hora. Los umbrales y los minutos de espera son parametros de la base.
Alertas__ProcesosActivos=true
Alertas__AvisosCadaMinutos=10
Alertas__UmbralesCadaMinutos=60

# ----------------------------------------------------------------------------- Sesion del portal (inicio de sesion unico)
# Access token 60 min y refresh 30 dias (los del portal). Ambos viajan en el cuerpo de las respuestas.
Sesion__AccessMinutos=60
Sesion__RefreshDias=30
# Base de usuarios del portal (TI), SOLO LECTURA. dbSolucionesTI en produccion, dbSolucionesTI_Prueba en pruebas.
PortalTi__ConnectionString=Server=<host>,1433;Database=dbSolucionesTI;User Id=<usuario_solo_lectura>;Password=<password>;Encrypt=True;TrustServerCertificate=False

# ----------------------------------------------------------------------------- Seguridad
Seguridad__PasswordMinimo=8
# true = solo el creador de una inspeccion (o un administrador) le agrega hallazgos/evidencias o la cierra.
Seguridad__ValidarPropiedadInspeccion=true
Seguridad__LoginMaxIntentosPorMinuto=10
Seguridad__LoginPortalMaxIntentosPorMinuto=30
Seguridad__RefreshMaxPorMinuto=60
Seguridad__LoginConductorMaxIntentosPorMinuto=60
# PIN errados seguidos que bloquean la cuenta de un conductor o inspector, y minutos que dura el bloqueo.
Seguridad__PinMaxIntentos=5
Seguridad__PinBloqueoMinutos=15
# true solo si la API esta detras de un proxy inverso de confianza (Railway, nginx...): usa X-Forwarded-For para el limite por IP.
Proxy__ConfiarEnEncabezadosReenviados=false

# ----------------------------------------------------------------------------- Operacion
# Publica /openapi/v1.json y la interfaz Swagger en /swagger (siempre disponibles en Development).
Documentacion__Habilitada=false
# Segundos que la API conserva los catalogos maestros en memoria (los cambios hechos por la API se ven al instante).
# Catalogos__CacheSegundos=60
# Solo para el comando crear-superadmin (ver README). No dejar en el entorno permanente.
SUPERADMIN_PASSWORD=
