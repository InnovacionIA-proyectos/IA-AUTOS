<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IA-AUTOS.API\IA-AUTOS.API.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Los scripts reales del proyecto se ejecutan contra SQL Server 2019 en las pruebas. -->
    <Content Include="..\..\database\00-crear-base.sql" Link="database\00-crear-base.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\database\ddl.sql" Link="database\ddl.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Todos los cambios de esquema y todos los esquemas previos entran por comodin: un script nuevo se incluye solo en la cadena de la prueba de migracion encadenada. -->
    <Content Include="..\..\database\cambios-esquema\*.sql" Link="database\cambios-esquema\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Infraestructura\Esquemas\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\openapi.json" Link="docs\openapi.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\openapi-versiones.json" Link="docs\openapi-versiones.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\CONTRATO.md" Link="CONTRATO.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
