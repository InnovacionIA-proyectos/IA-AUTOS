# Variables que necesita el CI (.github/workflows/ci-backend.yml) para probar contra el ENTORNO REAL.
# Este archivo es una PLANTILLA con marcadores: NUNCA escriba aqui valores reales ni lo use como .env.
# Cada variable se carga en GitHub como secreto (Settings > Secrets and variables > Actions) con el nombre de la
# columna "Secreto de GitHub"; el workflow la expone a las pruebas con el nombre de la variable de la API (igual que .env).
#
#   Variable de la API (.env)                  Secreto de GitHub
#   ConnectionStrings__DefaultConnection   ->  CONNECTIONSTRINGS_DEFAULTCONNECTION
#   Jwt__Secret                            ->  JWT_SECRET
#   Storage__S3__Endpoint                  ->  STORAGE_S3_ENDPOINT
#   Storage__S3__Bucket                    ->  STORAGE_S3_BUCKET
#   Storage__S3__AccessKey                 ->  STORAGE_S3_ACCESSKEY
#   Storage__S3__SecretKey                 ->  STORAGE_S3_SECRETKEY
#   Storage__S3__Region                    ->  variable (no secreto) STORAGE_S3_REGION; si falta se usa us-east-1
#   PortalTi__ConnectionString             ->  PORTALTI_CONNECTIONSTRING
#
# Las pruebas son SOLO LECTURA (SELECT y listados): no insertan, actualizan ni borran datos en la base ni en el almacen.
# Use las mismas credenciales de aplicacion de backend/.env (usuario de minimo privilegio, nunca "sa").
# El runner debe alcanzar la base y el MinIO: por eso el job corre en el runner self-hosted de la red corporativa.
#
# Para el despliegue (job "deploy") se necesita ademas el secreto DOKPLOY_DEPLOY_WEBHOOK_URL: la URL del webhook de la
# aplicacion en Dokploy (Deployments > Webhook URL). No va en este archivo.

# Base de datos real (SQL Server). El usuario debe tener como esquema por defecto el que contiene las tablas.
ConnectionStrings__DefaultConnection=Server=<host>,1433;Database=<base>;User Id=<usuario_app>;Password=<password_app>;Encrypt=True;TrustServerCertificate=<True|False>

# Secreto JWT de la API (minimo 32 caracteres); se requiere para que la API arranque en memoria durante las pruebas.
Jwt__Secret=<secreto_jwt_minimo_32_caracteres>

# MinIO real (S3 compatible).
Storage__S3__Endpoint=http://<host-minio>:<puerto>
Storage__S3__Bucket=<bucket>
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=<access_key>
Storage__S3__SecretKey=<secret_key>

# Base de usuarios del portal (TI), SOLO LECTURA, para las pruebas del inicio de sesion unico. En el CI debe apuntar a la base de
# PRUEBAS (dbSolucionesTI_Prueba), nunca a produccion. Secreto de GitHub: PORTALTI_CONNECTIONSTRING. El usuario solo necesita
# SELECT sobre tblSAPUsuariosApp, tblSAPUsuarioRoles, tblSAPRoles, tblSAPOpcionesRoles y tblSAPOpciones.
PortalTi__ConnectionString=Server=<host>,1433;Database=dbSolucionesTI_Prueba;User Id=<usuario_solo_lectura>;Password=<password>;Encrypt=True;TrustServerCertificate=<True|False>
